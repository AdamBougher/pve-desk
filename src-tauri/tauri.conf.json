{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pve-desk",
  "version": "1.0.0",
  "identifier": "dev.pvedesk.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "pve-desk",
        "width": 1000,
        "height": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "category": "Utility",
    "publisher": "Adam Bougher",
    "homepage": "https://github.com/AdamBougher/pve-desk",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "shortDescription": "Desktop client for Proxmox VE",
    "longDescription": "Saved logins kept in the system keyring, the full Proxmox web UI embedded and already signed in, and a read-only list of VMs and containers.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
