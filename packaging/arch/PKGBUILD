# Maintainer: Adam Bougher <adamsauce99@gmail.com>
pkgname=pve-desk
pkgver=1.1.0
pkgrel=1
pkgdesc="Desktop client for Proxmox VE"
arch=('x86_64')
# !lto is required, not cosmetic. makepkg.conf ships OPTIONS=(... lto ...)
# with LTOFLAGS=-flto=auto, so ring's build script compiles its C sources
# into GCC GIMPLE objects; rust-lld cannot read those and the binary fails
# to link with a dozen undefined ring_core_0_17_14__* symbols. Measured
# 2026-10-23 against the v1.0.1 tarball: fails without this, builds with it.
options=(!lto)
url="https://github.com/AdamBougher/pve-desk"
license=('MIT')
# webkit2gtk-4.1 is the webview; gtk3 is used directly for the tab strip
# (F14). librsvg renders the SVG icon.
depends=('webkit2gtk-4.1' 'libsoup3' 'gtk3' 'librsvg' 'gcc-libs' 'glibc')
makedepends=('cargo' 'pkgconf')
optdepends=(
  'gnome-keyring: Secret Service provider, needed to store saved passwords'
  'kwalletd6: alternative Secret Service provider'
  'virt-viewer: SPICE consoles (not yet reachable from the UI)'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver/src-tauri"
  # Arch ships a current rustc; the repo's rust-toolchain.toml pin exists for
  # reproducible development builds and is deliberately overridden here so
  # makepkg does not download a second toolchain.
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver/src-tauri"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # The frontend is embedded at build time, so this produces a single
  # self-contained binary — no need for `cargo tauri build` or its bundler.
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver/src-tauri"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "src-tauri/target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 "packaging/$pkgname.desktop" \
    "$pkgdir/usr/share/applications/$pkgname.desktop"
  install -Dm644 src-tauri/icons/32x32.png \
    "$pkgdir/usr/share/icons/hicolor/32x32/apps/$pkgname.png"
  install -Dm644 src-tauri/icons/128x128.png \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/$pkgname.png"
  install -Dm644 src-tauri/icons/icon.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/$pkgname.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
