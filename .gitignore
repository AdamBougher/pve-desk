# Rust / Cargo
/src-tauri/target/
**/*.rs.bk

# Tauri generated + bundler scratch
# gen/schemas is regenerated by `cargo check`; it is also the authoritative
# list of capability permissions, so don't be surprised it isn't tracked.
/src-tauri/gen/
/src-tauri/WixTools/
/.tauri/

# Local tool settings. Project skills in .claude/skills/ ARE tracked.
/.claude/settings.local.json

# Editors
*.swp
*~
/.idea/
/.vscode/

# OS cruft
.DS_Store
Thumbs.db

# Stray logs
*.log

# Screenshots the run skill takes. Run artifacts, and they picture whatever
# connection happens to be in the local config.
/.claude/skills/run-pve-desk/shots/

# makepkg output. README tells Arch users to run `makepkg -si` in
# packaging/arch, so the documented path leaves src/ (1.5G), pkg/, the source
# tarball and the built package behind. All regenerable; none of it is ours.
/packaging/arch/src/
/packaging/arch/pkg/
/packaging/arch/*.tar.gz
/packaging/arch/*.pkg.tar.zst

# Note: no secrets live in this repo. The password is in the system keyring
# and config.toml lives in ~/.config/pve-desk/, never in the tree.
